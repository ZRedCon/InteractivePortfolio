[sub_resource type="BoxMesh" id="BoxMesh_bpmhk"]

[sub_resource type="GDScript" id="GDScript_2ia5b"]
script/source = "extends MeshInstance3D

var ttl_time : float = 0

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	ttl_time += delta
	rotate_y(0.01)
	rotate_x(0.02)
	rotate_z(sin(ttl_time) * delta)
"

