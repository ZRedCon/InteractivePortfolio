[node name="AreaLight3D2" type="AreaLight3D" parent="." unique_id=1563472847]
editor_description = "Baked into each room's lightmap by Project > Tools > Bake Room Lighting, and hidden in game. The bake also copies it to each open neighbor's ceiling.
Godot 4.7.1 bakes area lights about 2.18x brighter than it draws them live, so this energy (0.917) bakes to the live look of 2.0.
It sits 5 cm below the ceiling so the ceiling doesn't block it in the bake."
